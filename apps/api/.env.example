# ------- Skyland API (Go) -------
SKYLAND_ENVIRONMENT=development
SKYLAND_DATABASE_URL=postgres://skyland:skyland_dev@localhost:5432/skyland

# Upstash (console.upstash.com → copiar URLs/tokens)
SKYLAND_UPSTASH_REDIS_URL=
SKYLAND_UPSTASH_REDIS_TOKEN=

# Auth: sin secretos — sesiones con tokens opacos (ADR-0005); el TTL,
# los presupuestos y la versión de términos son constantes del código.

# CORS: orígenes permitidos (coma-separado) — también alimenta el Origin
# check de los POST /auth/* (spec auth-player §2)
SKYLAND_CORS_ORIGINS=http://localhost:4321,http://localhost:4322,https://skyland.pages.dev
