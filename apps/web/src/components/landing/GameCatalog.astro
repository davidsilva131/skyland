---
import { games, statusLabel } from '../../data/games';
---

<section id="juegos" class="py-12">
  <h2 class="text-2xl font-black tracking-tight text-white">Juegos</h2>
  <p class="mt-1 text-sm text-zinc-400">Elige tu juego. Abriremos de a uno, con calma.</p>
  <div class="mt-6 grid gap-4 md:grid-cols-2">
    {games.map((game) => (
      <div class="flex items-center gap-4 rounded-2xl border border-white/10 bg-zinc-900 p-5">
        <span class="grid size-14 shrink-0 place-items-center rounded-xl bg-zinc-800 text-3xl">{game.emoji}</span>
        <div class="flex-1">
          <div class="flex items-center gap-2">
            <h3 class="font-bold text-white">{game.name}</h3>
            <span class="rounded-full bg-amber-400/10 px-2 py-0.5 text-xs font-bold uppercase tracking-wide text-amber-400">
              {statusLabel(game.status)}
            </span>
          </div>
          <p class="mt-0.5 text-sm text-zinc-400">{game.description}</p>
        </div>
        {game.status === 'live' && (
          <a href="/login" class="shrink-0 rounded-lg bg-amber-400 px-4 py-2 text-sm font-bold text-zinc-950 transition hover:bg-amber-300 active:scale-[0.98]">
            Jugar
          </a>
        )}
      </div>
    ))}
  </div>
</section>
