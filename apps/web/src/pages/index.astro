---
import Layout from '../layouts/Base.astro';
import SiteHeader from '../components/landing/SiteHeader.astro';
import Hero from '../components/landing/Hero.astro';
import LiveResults from '../components/landing/LiveResults.astro';
import GameCatalog from '../components/landing/GameCatalog.astro';
import HowItWorks from '../components/landing/HowItWorks.astro';
import Trust from '../components/landing/Trust.astro';
import Faq from '../components/landing/Faq.astro';
import SiteFooter from '../components/landing/SiteFooter.astro';
---

<Layout title="SkyLand — Lo tradicional, ahora en línea">
  <SiteHeader />
  <main class="mx-auto max-w-5xl px-4">
    <Hero />
    <LiveResults />
    <GameCatalog />
    <HowItWorks />
    <Trust />
    <Faq />
  </main>
  <SiteFooter />
</Layout>
