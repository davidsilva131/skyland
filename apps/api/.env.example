# ------- Skyland API -------
SKYLAND_ENVIRONMENT=development
SKYLAND_DATABASE_URL=postgresql+asyncpg://skyland:skyland_dev@localhost:5432/skyland

# Upstash (console.upstash.com → copiar URLs/tokens)
SKYLAND_UPSTASH_REDIS_URL=
SKYLAND_UPSTASH_REDIS_TOKEN=
SKYLAND_QSTASH_TOKEN=

# Auth (generar con: python -c "import secrets; print(secrets.token_urlsafe(48))")
SKYLAND_JWT_SECRET=dev-secret-change-me

# CORS: orígenes permitidos (coma-separado)
SKYLAND_CORS_ORIGINS=http://localhost:4321,http://localhost:4322,https://skyland.pages.dev