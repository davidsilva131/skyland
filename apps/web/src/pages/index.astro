---
import Layout from '../layouts/Base.astro';
import { games, statusLabel } from '../data/games';
---

<Layout title="SkyLand — Lo tradicional, ahora en línea">
  <header class="sticky top-0 z-20 border-b border-white/10 bg-zinc-950/80 backdrop-blur">
    <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
      <a href="/" class="flex items-center gap-2 text-lg font-black tracking-tight text-amber-400">
        <span class="grid size-8 place-items-center rounded-lg bg-amber-400/10 text-xl">🎲</span>
        SkyLand
      </a>
      <div class="hidden items-center gap-6 text-sm text-zinc-300 md:flex">
        <a href="#juegos" class="hover:text-white">Juegos</a>
        <a href="#como-funciona" class="hover:text-white">Cómo funciona</a>
        <a href="#preguntas" class="hover:text-white">Preguntas</a>
      </div>
      <div class="flex items-center gap-3">
        <a href="/login" class="rounded-lg px-4 py-2 text-sm font-semibold text-zinc-300 hover:text-white">Entrar</a>
        <a href="/login?mode=register" class="rounded-lg bg-amber-400 px-4 py-2 text-sm font-bold text-zinc-950 transition hover:bg-amber-300 active:scale-[0.98]">
          Crear cuenta
        </a>
      </div>
    </nav>
  </header>

  <main class="mx-auto max-w-5xl px-4">

    <!-- Hero -->
    <section class="grid gap-12 py-16 md:grid-cols-2 md:items-center md:py-24">
      <div>
        <p class="mb-4 inline-block rounded-full border border-amber-400/30 bg-amber-400/10 px-3 py-1 text-xs font-semibold text-amber-300">
          🇻🇪 Lo tradicional, ahora en tu celular
        </p>
        <h1 class="text-4xl font-black leading-tight tracking-tight text-balance text-white md:text-6xl">
          Los <span class="text-amber-400">animalitos</span> que amas, ahora en línea
        </h1>
        <p class="mt-4 max-w-md text-zinc-400">
          Skyland trae los juegos tradicionales venezolanos a tu celular: recarga con pago móvil, juega animalitos y pronto caballos, todo en un solo lugar.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/login?mode=register" class="rounded-xl bg-amber-400 px-6 py-3 font-bold text-zinc-950 transition hover:bg-amber-300 active:scale-[0.98]">
            Crear cuenta
          </a>
          <a href="/login" class="rounded-xl border border-white/10 px-6 py-3 font-semibold text-white transition hover:border-white/30 active:scale-[0.98]">
            Entrar
          </a>
        </div>
        <p class="mt-5 text-xs text-zinc-500">+18 · Juego responsable · Pago móvil</p>
      </div>

      <div class="rounded-2xl border border-white/10 bg-zinc-900 p-6">
        <div class="flex items-center justify-between">
          <p class="text-sm font-semibold text-zinc-300">Tabla de animalitos</p>
          <span class="rounded-full bg-amber-400/10 px-2 py-0.5 text-xs font-bold uppercase tracking-wide text-amber-400">Próximamente</span>
        </div>
        <div class="mt-4 grid grid-cols-4 gap-2 text-center text-xl sm:grid-cols-5">
          {['🐓', '🐂', '🐎', '🐘', '🦁', '🐅', '🐵', '🦌', '🐊', '🐇'].map((e) => (
            <span class="grid place-items-center rounded-lg bg-zinc-800 py-2 opacity-40">{e}</span>
          ))}
        </div>
        <p class="mt-4 text-sm text-zinc-500">Cuando Animalitos abra, aquí verás el tablero completo.</p>
      </div>
    </section>

    <!-- Resultados en vivo -->
    <section id="resultados" class="py-12">
      <h2 class="text-2xl font-black tracking-tight text-white">Últimos resultados</h2>
      <p class="mt-1 text-sm text-zinc-400">Se activan cuando el primer juego esté abierto.</p>
      <div class="mt-6 rounded-2xl border-2 border-dashed border-white/10 bg-zinc-900/50 p-8 text-center">
        <p class="font-mono text-4xl font-black text-zinc-600">--:--</p>
        <p class="mt-2 text-sm text-zinc-500">
          Los resultados aparecerán aquí en cuanto Animalitos abra sus sorteos. No publicamos números de prueba.
        </p>
      </div>
    </section>

    <!-- Catálogo -->
    <section id="juegos" class="py-12">
      <h2 class="text-2xl font-black tracking-tight text-white">Juegos</h2>
      <p class="mt-1 text-sm text-zinc-400">Elige tu juego. Abriremos de a uno, con calma.</p>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {games.map((game) => (
          <div class="flex items-center gap-4 rounded-2xl border border-white/10 bg-zinc-900 p-5">
            <span class="grid size-14 shrink-0 place-items-center rounded-xl bg-zinc-800 text-3xl">{game.emoji}</span>
            <div class="flex-1">
              <div class="flex items-center gap-2">
                <h3 class="font-bold text-white">{game.name}</h3>
                <span class="rounded-full bg-amber-400/10 px-2 py-0.5 text-xs font-bold uppercase tracking-wide text-amber-400">
                  {statusLabel(game.status)}
                </span>
              </div>
              <p class="mt-0.5 text-sm text-zinc-400">{game.description}</p>
            </div>
            {game.status === 'live' && (
              <a href="/login" class="shrink-0 rounded-lg bg-amber-400 px-4 py-2 text-sm font-bold text-zinc-950 transition hover:bg-amber-300 active:scale-[0.98]">
                Jugar
              </a>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Cómo funciona -->
    <section id="como-funciona" class="py-12">
      <h2 class="text-2xl font-black tracking-tight text-white">Cómo funciona</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-white/10 bg-zinc-900 p-6">
          <span class="grid size-9 place-items-center rounded-lg bg-amber-400/10 text-lg font-black text-amber-400">1</span>
          <h3 class="mt-3 font-bold text-white">Recarga con pago móvil</h3>
          <p class="mt-1 text-sm text-zinc-400">
            Transfiere desde tu banco a la cuenta de la Casa y reporta la referencia de 6 dígitos.
            La verificación es manual al principio, luego automática.
          </p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-zinc-900 p-6">
          <span class="grid size-9 place-items-center rounded-lg bg-amber-400/10 text-lg font-black text-amber-400">2</span>
          <h3 class="mt-3 font-bold text-white">Apuesta</h3>
          <p class="mt-1 text-sm text-zinc-400">Elige tu jugada en cualquiera de los juegos abiertos del catálogo.</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-zinc-900 p-6">
          <span class="grid size-9 place-items-center rounded-lg bg-amber-400/10 text-lg font-black text-amber-400">3</span>
          <h3 class="mt-3 font-bold text-white">Cobra</h3>
          <p class="mt-1 text-sm text-zinc-400">Si ganas, el saldo se acredita automáticamente a tu cuenta.</p>
        </div>
      </div>
    </section>

    <!-- Confianza / Legal -->
    <section class="py-12">
      <h2 class="text-2xl font-black tracking-tight text-white">Juega con confianza</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        <div class="rounded-2xl border border-white/10 bg-zinc-900 p-6">
          <p class="text-2xl">🔞</p>
          <h3 class="mt-2 font-bold text-white">Solo mayores de 18</h3>
          <p class="mt-1 text-sm text-zinc-400">El acceso y las apuestas están reservados a personas adultas.</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-zinc-900 p-6">
          <p class="text-2xl">🛡️</p>
          <h3 class="mt-2 font-bold text-white">Juego responsable</h3>
          <p class="mt-1 text-sm text-zinc-400">Apostar es entretenimiento, no un ingreso. Fija tus límites y respétalos.</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-zinc-900 p-6">
          <p class="text-2xl">🏠</p>
          <h3 class="mt-2 font-bold text-white">Sorteos de la Casa</h3>
          <p class="mt-1 text-sm text-zinc-400">
            Nuestro propio generador de números decide cada sorteo. No dependemos de la lotería oficial ni de terceros.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="preguntas" class="py-12">
      <h2 class="text-2xl font-black tracking-tight text-white">Preguntas frecuentes</h2>
      <div class="mt-6 grid gap-3">
        {[
          ['¿Qué es Skyland?', 'Una plataforma venezolana para jugar a los juegos tradicionales: animalitos hoy, caballos pronto, con recargas por pago móvil.'],
          ['¿Cómo recargo mi saldo?', 'Haces una transferencia por pago móvil a la cuenta de la Casa y reportas la referencia de 6 dígitos. Al principio la verificamos manualmente.'],
          ['¿Los animalitos son la lotería oficial?', 'No. Corremos sorteos propios con el generador de números de la plataforma. No dependemos de la lotería oficial.'],
          ['¿Cuánto cuesta crear cuenta?', 'Nada. Crear cuenta es gratis; solo necesitas ser mayor de 18 años.'],
          ['¿Cuándo abren los juegos?', 'Animalitos abre primero. Mientras tanto lo verás marcado como "Próximamente" en el catálogo.'],
          ['¿Es seguro jugar aquí?', 'Trabajamos con juego responsable, límites claros y sorteos de la Casa auditables. El acceso es exclusivo para mayores de 18.'],
        ].map(([q, a]) => (
          <details class="group rounded-2xl border border-white/10 bg-zinc-900 open:border-amber-400/30">
            <summary class="flex cursor-pointer items-center justify-between gap-4 p-5 font-semibold text-white marker:hidden [&::-webkit-details-marker]:hidden">
              {q}
              <span class="text-amber-400 transition group-open:rotate-45">+</span>
            </summary>
            <p class="px-5 pb-5 text-sm text-zinc-400">{a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <footer class="border-t border-white/10">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 py-10 md:grid-cols-3">
      <div>
        <p class="flex items-center gap-2 text-lg font-black tracking-tight text-amber-400">
          <span class="grid size-8 place-items-center rounded-lg bg-amber-400/10 text-xl">🎲</span>
          Skyland
        </p>
        <p class="mt-2 text-sm text-zinc-500">Los juegos tradicionales, ahora en línea.</p>
      </div>
      <div class="text-sm">
        <p class="font-semibold text-zinc-300">Cuenta</p>
        <a href="/login" class="mt-2 block text-zinc-500 hover:text-white">Entrar</a>
        <a href="/login?mode=register" class="mt-1 block text-zinc-500 hover:text-white">Crear cuenta</a>
      </div>
      <div class="text-sm text-zinc-500">
        <p class="font-semibold text-zinc-300">Información</p>
        <p class="mt-2">Términos y condiciones: próximamente</p>
        <p class="mt-1">Instalar la app: próximamente en tu teléfono</p>
      </div>
    </div>
    <p class="border-t border-white/5 py-6 text-center text-xs text-zinc-600">
      Skyland · Juego responsable · +18 · Sorteos de la Casa con RNG propio
    </p>
  </footer>
</Layout>
