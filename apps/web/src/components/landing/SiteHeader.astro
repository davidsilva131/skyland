---
// Header de la landing: logo + anclas + Entrar/Crear cuenta.
---

<header class="sticky top-0 z-20 border-b border-white/10 bg-zinc-950/80 backdrop-blur">
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
    <a href="/" class="flex items-center gap-2 text-lg font-black tracking-tight text-amber-400">
      <span class="grid size-8 place-items-center rounded-lg bg-amber-400/10 text-xl">🎲</span>
      SkyLand
    </a>
    <div class="hidden items-center gap-6 text-sm text-zinc-300 md:flex">
      <a href="#juegos" class="hover:text-white">Juegos</a>
      <a href="#como-funciona" class="hover:text-white">Cómo funciona</a>
      <a href="#preguntas" class="hover:text-white">Preguntas</a>
    </div>
    <div class="flex items-center gap-3">
      <a href="/login" class="rounded-lg px-4 py-2 text-sm font-semibold text-zinc-300 hover:text-white">Entrar</a>
      <a href="/login?mode=register" class="rounded-lg bg-amber-400 px-4 py-2 text-sm font-bold text-zinc-950 transition hover:bg-amber-300 active:scale-[0.98]">
        Crear cuenta
      </a>
    </div>
  </nav>
</header>
